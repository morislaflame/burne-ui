{
  "name": "burne-ui-skin-__SKIN_NAME__",
  "version": "0.1.0",
  "description": "__SKIN_TITLE__ skin for Burne UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "src/skin.css",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./skin.json": "./dist/skin.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/skin.css dist/styles.css && cp src/skin.json dist/skin.json && rm -f dist/*.map",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/smoke.mjs"
  },
  "peerDependencies": {
    "burne-ui": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
