{
  "fontFamilySans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
  "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
  "textScale": {
    "xsmall": { "size": 0.6875, "line": 0.875 },
    "small": { "size": 0.75, "line": 1 },
    "base": { "size": 0.875, "line": 1.25 },
    "mid": { "size": 1, "line": 1.5 },
    "large": { "size": 1.15, "line": 1.75 },
    "xlarge": { "size": 1.5, "line": 2 },
    "2xlarge": { "size": 1.875, "line": 2.25 },
    "3xlarge": { "size": 2.25, "line": 2.5 }
  },
  "shadowOpacity": {
    "dark": {
      "small": { "rest": 0.1, "hover": 0.14, "press": 0.07 },
      "base": { "rest": 0.15, "hover": 0.19, "press": 0.1 },
      "mid": { "rest": 0.2, "hover": 0.24, "press": 0.14 },
      "large": { "rest": 0.24, "hover": 0.28, "press": 0.17 },
      "lift": { "hover": 0.15 }
    },
    "light": {
      "small": { "rest": 0.05, "hover": 0.08, "press": 0.03 },
      "base": { "rest": 0.08, "hover": 0.11, "press": 0.05 },
      "mid": { "rest": 0.12, "hover": 0.15, "press": 0.08 },
      "large": { "rest": 0.16, "hover": 0.2, "press": 0.11 },
      "lift": { "hover": 0.08 }
    }
  },
  "shadowGeom": {
    "small": {
      "rest": [0, 1, 1, 0],
      "hover": [0, 2, 2, -1],
      "press": [0, 1, 1, 0]
    },
    "base": {
      "rest": [0, 2, 2, -1],
      "hover": [0, 3, 3, -1],
      "press": [0, 1, 1, 0]
    },
    "mid": {
      "rest": [2, 4, 3, -2],
      "hover": [2, 5, 4, -2],
      "press": [1, 2, 2, -1]
    },
    "large": {
      "rest": [3, 6, 5, -3],
      "hover": [3, 7, 6, -3],
      "press": [2, 4, 3, -2]
    },
    "lift": {
      "hover": [0, 2, 2, -1]
    }
  }
}
