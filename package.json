{
  "name": "burne-ui",
  "version": "1.6.1",
  "description": "React UI kit (Burne UI)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "cli"
  ],
  "bin": {
    "burne-ui": "./cli/burne-ui.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs",
      "default": "./dist/internal.js"
    },
    "./styles.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "playground": "vite --config vite.playground.config.ts",
    "playground:tunnel": "tuna http 5173 --subdomain=drus",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-package-export-parity.mjs",
    "check:exports": "node scripts/check-package-export-parity.mjs",
    "storybook": "bash scripts/storybook.sh",
    "build-storybook": "storybook build -o storybook-static",
    "chromatic": "chromatic --build-script-name build-storybook",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 vitest",
    "test:coverage": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --coverage",
    "test-storybook": "PLAYWRIGHT_BROWSERS_PATH=0 vitest --project=storybook",
    "test-storybook:run": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=storybook",
    "test-storybook:coverage": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=storybook --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-icons": "^5.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "chromatic": "^17.7.2",
    "playwright": "^1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "storybook": "10.4.6",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.9"
  }
}
