  "scripts": {
    "build": "node scripts/sync-generated-tokens.mjs && node scripts/build-tailwind-entry.mjs && vite build && node scripts/fix-dts-extensions.mjs && node scripts/check-rsc-boundaries.mjs && node scripts/check-dist-exports.mjs && node scripts/check-kit-motion-recipes-dist.mjs && node scripts/check-tree-shaking.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-hover-media.mjs && node scripts/check-attw.mjs",
    "check:attw": "node scripts/check-attw.mjs",
    "dev": "vite build --watch",
    "playground": "vite --config vite.playground.config.ts",
    "playground:tunnel": "tuna http 5173 --subdomain=drus",
    "lint": "node scripts/lint-steps.mjs",
    "lint:eslint": "eslint . --max-warnings 37",
    "sync:tokens": "node scripts/sync-generated-tokens.mjs",
    "check:exports": "node scripts/check-package-export-parity.mjs && node scripts/check-component-subpath-exports.mjs && node scripts/check-public-surface.mjs",
    "check:motion-docs": "node scripts/check-motion-docs-parity.mjs",
    "check:docs-headings": "node scripts/check-component-docs-heading-parity.mjs",
    "storybook": "bash scripts/storybook.sh",
    "build-storybook": "storybook build -o storybook-static",
    "chromatic": "chromatic --build-script-name build-storybook",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 vitest --project=unit --project=components",
    "test:run": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=unit --project=components",
    "test:coverage": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=unit --project=components --coverage",
    "test-storybook": "PLAYWRIGHT_BROWSERS_PATH=0 vitest --project=storybook",
    "test-storybook:run": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=storybook",
    "test-storybook:coverage": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=storybook --coverage",
    "bench:providers": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run --project=perf"
  },
